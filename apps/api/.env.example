NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Must point at a replica set (Atlas always is,
# including the free M0 tier) because payment writes run inside a transaction.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/crossval-settlements?retryWrites=true&w=majority

# Access tokens are short lived; refresh tokens are rotated on every use.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Comma separated. Only needed for direct API access; the web app reaches the API
# through a same-origin proxy and never triggers CORS.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
