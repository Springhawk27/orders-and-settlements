{
  "name": "orders-and-settlements",
  "version": "1.0.0",
  "private": true,
  "description": "Orders and settlements tracker with partial payments, derived status and an audit trail",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @crossval/api dev",
    "dev:web": "pnpm --filter @crossval/web dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "test": "pnpm --recursive --sequential test",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter @crossval/api seed",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,json,md,css,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.67.0"
  }
}
